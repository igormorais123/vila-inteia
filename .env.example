# Vila INTEIA — variáveis de ambiente
# Copie para .env e preencha. Nunca commite .env no repo.

# =====================================================
# LLM (OmniRoute é o caminho recomendado — custo zero)
# =====================================================
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_API_KEY=

# Fallback Anthropic (pago por token) — usado se OmniRoute falhar
CLAUDE_API_KEY=
IA_ALLOW_API_FALLBACK=false

# =====================================================
# Servidor
# =====================================================
PORT=8100

# =====================================================
# SUPABASE — persistência cloud da Vila
# Projeto sugerido: conecta-2026 (ou o que você criar)
# URL: https://<projeto>.supabase.co
# =====================================================
SUPABASE_VILA_URL=https://SEU_PROJETO.supabase.co
SUPABASE_VILA_KEY=SUA_ANON_KEY_AQUI

# =====================================================
# MIRANTE NEWS — publicação automática de matérias
# Endpoint que recebe submissões: POST <URL>/api/vila/submissoes
# Token é shared secret com o VILA_MIRANTE_TOKEN do lado Mirante.
# =====================================================
MIRANTE_API_URL=https://mirantenews.com.br
MIRANTE_API_TOKEN=
MIRANTE_TIMEOUT_S=30
MIRANTE_MAX_RETRIES=3

# Fallback dev: se não usar a API, escreve MDX numa pasta local
# (útil para quem tem o repo do Mirante clonado localmente)
MIRANTE_CONTENT_DIR=

# =====================================================
# MIROFISH — simulação de rede social com grafos
# =====================================================
MIROFISH_API_URL=
MIROFISH_TIMEOUT_S=60

# =====================================================
# OSA (Optimal System Agent) — opcional, Signal Theory
# =====================================================
OSA_URL=http://localhost:8089
