# Vila INTEIA — Variaveis de Ambiente
# Copie para .env e preencha os valores

# OmniRoute (gratuito via VPS)
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_API_KEY=

# Anthropic (fallback pago)
CLAUDE_API_KEY=
IA_ALLOW_API_FALLBACK=false

# Servidor
PORT=8100

# SUPABASE — Vila INTEIA (persistencia na nuvem)
# ATENCAO: nunca commite URL ou key reais. Use apenas placeholders aqui.
# URL real segue o padrao: https://<id_projeto>.supabase.co
SUPABASE_VILA_URL=https://seu_projeto_id.supabase.co
SUPABASE_VILA_KEY=sua_anon_key_aqui
